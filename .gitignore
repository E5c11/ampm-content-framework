# Node (content-pipeline tooling)
node_modules/
dist/
*.log

# Python (doc-graph/framework upkeep tooling)
__pycache__/
*.pyc
.venv/

# Environment / credentials — never committed; service-account files stay in
# AMPM/.firebase/ and are referenced by absolute path from a local .env
.env

# Session working files (vocab snapshots, extracted images, review output)
temp/

# Source material dropped in for a session — exam paper/memo/addendum PDFs, lookup CSVs.
# Not code, not this framework's output; never committed (bulky, often copyrighted DBE papers).
files/

# IDE / OS
.idea/
.DS_Store
