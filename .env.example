# Copy to .env (untracked) and adjust for your machine.

# ── Firebase service-account JSONs (read-only Firestore access; stay in AMPM/.firebase/) ──
# Still used by dump-curriculum-vocabulary.js until Phase 4 of
# workflows/active/repoint-authoring-to-postgres.md repoints it at the backend read API.
AMPM_FIREBASE_SA_DEV=/home/emmanuel/StudioProjects/AMPM/.firebase/ampm-b9661-firebase-adminsdk-egrss-822535c2db.json
AMPM_FIREBASE_SA_PROD=/home/emmanuel/StudioProjects/AMPM/.firebase/ampm-prod-3c0f6-firebase-adminsdk-fbsvc-bda7350259.json

# ── Cloud SQL (ampm-backend) — the content write target ──
# Connect through the Cloud SQL Auth Proxy, never directly. Start it first:
#   cloud-sql-proxy ampm-b9661:us-central1:ampm-backend --port 15432
# The dev password is in Secret Manager:
#   gcloud secrets versions access latest --secret=AMPM_DB_PASSWORD --project=ampm-b9661
PG_HOST_DEV=127.0.0.1
PG_PORT_DEV=15432
PG_DATABASE_DEV=ampm
PG_USER_DEV=ampm
PG_PASSWORD_DEV=
CLOUD_SQL_CONNECTION_NAME_DEV=ampm-b9661:us-central1:ampm-backend

# Prod — owner-gated (D4). Leave blank until a prod run is explicitly authorised.
PG_HOST_PROD=
PG_PORT_PROD=5432
PG_DATABASE_PROD=
PG_USER_PROD=
PG_PASSWORD_PROD=
